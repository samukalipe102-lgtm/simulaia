# ============================================================
# Simula Escola IA — Backend environment variables
# Copy this file to ".env" and fill in the values.
# NEVER commit the real ".env" file to a public repository.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Security ---
# Long random string used to sign admin JWT sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h

# Initial admin account created on first run (change after first login).
ADMIN_EMAIL=admin@simulaescola.local
ADMIN_PASSWORD=change-this-password

# --- Database ---
# Path to the SQLite database file (persistent store).
DATABASE_FILE=./data/simula.db

# --- Gmail / Google OAuth 2.0 ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/oauth/callback

# --- Safety / Test mode ---
# When true, the system ONLY sends emails to AUTHORIZED_RECIPIENT.
TEST_MODE=true
# The single authorized recipient used in test mode (your own inbox).
AUTHORIZED_RECIPIENT=

# --- Optional AI (LLM) ---
# If set, the request generator uses an LLM; otherwise it uses the built-in
# deterministic template engine (fully functional offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
